generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum TipoUsuario {
  ALUNO
  PROFESSOR
  ADMIN
}

model Usuario {
  id           Int         @id @default(autoincrement())
  nome         String
  email        String      @unique
  senha        String
  tipo         TipoUsuario @default(ALUNO)
  dataCadastro DateTime    @default(now())

  simulados  Simulado[]
  flashcards FlashcardUsuario[]

  @@map("usuarios")
}

model Materia {
  id        Int    @id @default(autoincrement())
  nome      String
  descricao String

  conteudos Conteudo[]

  @@map("materias")
}

model Conteudo {
  id          Int      @id @default(autoincrement())
  titulo      String
  resumo      String
  ordem       Int
  dataCriacao DateTime @default(now())

  materiaId Int
  materia   Materia @relation(fields: [materiaId], references: [id])

  questoes   Questao[]
  flashcards Flashcard[]

  @@map("conteudos")
}

model Questao {
  id          Int    @id @default(autoincrement())
  enunciado   String
  dificuldade String
  area        String
  ano         String

  conteudoId Int
  conteudo   Conteudo @relation(fields: [conteudoId], references: [id])

  alternativas Alternativa[]
  respostas    Resposta[]

  @@map("questoes")
}

model Alternativa {
  id      Int     @id @default(autoincrement())
  texto   String
  correta Boolean
  ordem   String

  questaoId Int
  questao   Questao @relation(fields: [questaoId], references: [id])

  respostas Resposta[]

  @@map("alternativas")
}

model Simulado {
  id             Int      @id @default(autoincrement())
  dataRealizacao DateTime
  comTempo       Boolean
  tempoTotalMin  Int?
  notaObjetiva   Float?
  notaTri        Float?

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  respostas Resposta[]

  @@map("simulados")
}

model Resposta {
  id           Int      @id @default(autoincrement())
  dataResposta DateTime @default(now())
  correta      Boolean

  simuladoId    Int
  questaoId     Int
  alternativaId Int

  simulado    Simulado    @relation(fields: [simuladoId], references: [id])
  questao     Questao     @relation(fields: [questaoId], references: [id])
  alternativa Alternativa @relation(fields: [alternativaId], references: [id])

  @@map("respostas")
}

model Flashcard {
  id       Int    @id @default(autoincrement())
  pergunta String
  resposta String
  ordem    Int

  conteudoId Int
  conteudo   Conteudo @relation(fields: [conteudoId], references: [id])

  usuarios FlashcardUsuario[]

  @@map("flashcards")
}

model FlashcardUsuario {
  id           Int      @id @default(autoincrement())
  dataRevisao  DateTime
  nivelDominio Int

  usuarioId   Int
  flashcardId Int

  usuario   Usuario   @relation(fields: [usuarioId], references: [id])
  flashcard Flashcard @relation(fields: [flashcardId], references: [id])

  @@map("flashcards_usuarios")
}